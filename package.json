{
	"name": "my-social-feeds",
	"version": "0.1.0",
	"description": "Example block scaffolded with Create Block tool.",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"packages-update": "wp-scripts packages-update",
		"lint": "eslint src",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"format": "wp-scripts format",
		"start": "wp-scripts start --webpack-copy-php",
		"build": "wp-scripts build --webpack-copy-php",
		"i18n-pot": "wp i18n make-pot . languages/my-social-feeds.pot --exclude=\"src\" && cp ./languages/my-social-feeds.pot ./languages/my-social-feeds-en_US.po",
		"i18n-json": "wp i18n make-json languages/ --no-purge",
		"i18n-mo": "wp i18n make-mo languages/",
		"i18n": "npm run i18n-pot && npm run i18n-json && npm run i18n-mo",
		"find-ds": "find . -name '.DS_Store' -delete",
		"zip": "npm run build && npm run find-ds && rm -f my-social-feeds.zip && zip -r my-social-feeds.zip index.php my-social-feeds.php readme.txt includes vendor old-pinterest-feed build public assets languages -x '*.DS_Store' -x '*.map'"
	},
	"dependencies": {
		"immer": "^10.1.1",
		"install": "^0.13.0",
		"react-justified-grid": "^1.0.0",
		"react-responsive-masonry": "^2.7.1",
		"react-router-dom": "^7.9.6",
		"swiper": "^12.0.3"
	},
	"devDependencies": {
		"@wordpress/scripts": "^27.9.0",
		"eslint-webpack-plugin": "^4.2.0"
	},
	"files": [
		"build",
		"languages",
		"public",
		"my-social-feeds.php",
		"Instagram.php",
		"TiktokAPI.php"
	]
}